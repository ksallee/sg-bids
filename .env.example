# Dev only. With these set, `pnpm dev` reads the site through the script key and no sign-in is needed.
# A production build ignores them: the page then signs in through the App Session Launcher.
FPT_API_SITE_URL=https://studio.shotgrid.autodesk.com
FPT_API_SCRIPT_NAME=
FPT_API_API_KEY=
# The site the sign-in form offers by default.
PUBLIC_FPT_SITE_URL=https://studio.shotgrid.autodesk.com
# Server only. The Supabase project and its secret (service role) key. The browser never sees them.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The Flow PT hosts the server may call for a production sign-in, comma separated. Unset: the host
# of PUBLIC_FPT_SITE_URL.
FPT_SITE_HOSTS=
# Server only. The Flow PT permission group codes that may act as production, comma separated.
# Unset: admin,manager. Anyone else is refused, a Vendor person included.
FPT_PRODUCTION_ROLES=
